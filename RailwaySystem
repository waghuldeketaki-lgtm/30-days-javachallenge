import java.util.*;

class Passenger {
    int id;
    String name;
    String trainName;
    String source;
    String destination;

    // Constructor
    Passenger(int id, String name, String trainName, String source, String destination) {
        this.id = id;
        this.name = name;
        this.trainName = trainName;
        this.source = source;
        this.destination = destination;
    }

    // Display Method
    void display() {
        System.out.println("ID: " + id + 
                           " Name: " + name + 
                           " Train: " + trainName + 
                           " From: " + source + 
                           " To: " + destination);
    }
}

